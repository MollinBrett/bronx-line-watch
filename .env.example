# Local development: copy this file to .env (git ignores it), fill in your own values, then `npm run dev`.
# Production values live in Render's Environment settings, never in a file.
ANTHROPIC_API_KEY=

# Optional - Telegram. A bot (from @BotFather) that is an admin of the channel(s).
# Set only one channel to post both languages together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_EN=
TELEGRAM_CHANNEL_ES=

# Optional - leave blank to print messages instead of texting.
# Texting ALSO requires SEND_SMS=true, which belongs ONLY in Render's settings, never in
# a local .env: without it, nothing is texted even if the Twilio settings are present.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+18885276698
# Comma-separated phone:language[:lines] entries, e.g. +17185550100:es:4,5,+13475550199:en
# Lines are optional (any of 2, 4, 5, 6, 6X, B, D); leave them off to get every Bronx line.
SMS_SUBSCRIBERS=

# Tuning (defaults shown)
POLL_SECONDS=60
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
STATE_FILE=data/state.json

# Pausing (README, "Pausing and resuming"). PAUSED=true: keep watching, send nothing, call nothing.
PAUSED=
# To resume after the watcher paused itself: the code from its alert.
RESUME_AFTER_TRIP=
# Private Telegram chat (numeric id) the bot tells when the watcher pauses itself. Never a public channel.
TELEGRAM_CHANNEL_ADMIN=
# Limits that pause it. Blank means the default: texts are 24 an hour and 120 a day per subscriber.
MAX_TEXTS_PER_HOUR=
MAX_TEXTS_PER_DAY=
MAX_CLAUDE_CALLS_PER_HOUR=30
MAX_SAFETY_BLOCKS_IN_A_ROW=3
# Alerts over this many in one poll wait for the next poll (this one doesn't pause it).
MAX_ALERTS_PER_POLL=5
