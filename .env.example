# Copy to your host's secret settings (never commit real values).
ANTHROPIC_API_KEY=

# Optional - leave blank to print messages instead of texting.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated phone:language pairs, e.g. +17185550100:es,+13475550199:en
SMS_SUBSCRIBERS=

# Tuning (defaults shown)
POLL_SECONDS=60
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
STATE_FILE=data/state.json
