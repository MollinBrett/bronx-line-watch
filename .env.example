# Local development: copy this file to .env (git ignores it), fill in your own values, then `npm run dev`.
# Production values live in Render's Environment settings, never in a file.
ANTHROPIC_API_KEY=

# Optional - Telegram. A bot (from @BotFather) that is an admin of the channel(s).
# Set only one channel to post both languages together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_EN=
TELEGRAM_CHANNEL_ES=

# Optional - leave blank to print messages instead of texting.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+18885276698
# Comma-separated phone:language pairs, e.g. +17185550100:es,+13475550199:en
SMS_SUBSCRIBERS=

# Tuning (defaults shown)
POLL_SECONDS=60
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
STATE_FILE=data/state.json
