# Local development: copy this file to .env (git ignores it), fill in your own values, then `npm run dev`.
# Production values live in Render's Environment settings, never in a file.
ANTHROPIC_API_KEY=

# Optional - Telegram. A bot (from @BotFather) that is an admin of the channel(s).
# Set only one channel to post both languages together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_EN=
TELEGRAM_CHANNEL_ES=

# Optional - leave blank to print messages instead of texting.
# Texting ALSO requires SEND_SMS=true, which belongs ONLY in Render's settings, never in
# a local .env: without it, nothing is texted even if the Twilio settings are present.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+18885276698
# Comma-separated phone:language[:lines][:quiet] entries, e.g. +17185550100:es:4,5,+13475550199:en:quiet
# Lines are optional (any of 2, 4, 5, 6, 6X, B, D); leave them off to get every Bronx line.
# Add :quiet for a rider who asked for quiet hours: no texts 11 PM-5 AM New York time except
# suspensions. Without it, texts go out at any hour.
SMS_SUBSCRIBERS=

# Tuning (defaults shown)
POLL_SECONDS=60
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
STATE_FILE=data/state.json
