{
  "name": "bronx-line-watch",
  "version": "0.1.0",
  "description": "Plain-language English/Spanish subway alerts for Bronx riders, maintained by a team of Claude agents",
  "scripts": {
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "once": "tsx src/main.ts --once --dry-run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "schedule-agents": "tsx scripts/schedule-agents.ts",
    "dev": "tsx --env-file=.env src/main.ts --no-sms --announce-existing",
    "security": "node scripts/security-check.mjs",
    "freshness": "node scripts/freshness-check.mjs",
    "check": "npm audit --audit-level=low && node scripts/freshness-check.mjs && node scripts/security-check.mjs && tsc --noEmit && vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
