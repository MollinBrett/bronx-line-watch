{
  "name": "bronx-line-watch",
  "version": "0.1.0",
  "description": "Plain-language English/Spanish subway alerts for Bronx riders, maintained by a team of Claude agents",
  "scripts": {
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "once": "tsx src/main.ts --once --dry-run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "schedule-agents": "tsx scripts/schedule-agents.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
